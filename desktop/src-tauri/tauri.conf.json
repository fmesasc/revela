{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Revela",
  "version": "0.1.0",
  "identifier": "io.github.fmesasc.revela",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [
      { "title": "Revela", "width": 1400, "height": 900, "minWidth": 800, "minHeight": 560, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Editor de presentaciones",
    "longDescription": "Revela: crea presentaciones como en PowerPoint y preséntalas con reveal.js.",
    "copyright": "MIT License",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
