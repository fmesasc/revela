{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Revela",
  "version": "0.4.0",
  "identifier": "io.github.fmesasc.revela",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Revela",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Editor de presentaciones",
    "longDescription": "Revela: crea presentaciones como en PowerPoint y preséntalas con reveal.js.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "fmesasc",
    "homepage": "https://fmesasc.github.io/revela/",
    "license": "MIT",
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/io.github.fmesasc.revela.metainfo.xml": "metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/io.github.fmesasc.revela.metainfo.xml": "metainfo.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/io.github.fmesasc.revela.metainfo.xml": "metainfo.xml"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5NUY1RkU4NDhDNUQyQTcKUldTbjBzVkk2RjlmYWROVGpvY0w4dnY4bnoxOUZwdGltOWZ5U1kvZTlMNG8yVkpoWURMamIwTUkK",
      "endpoints": [
        "https://github.com/fmesasc/revela/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
