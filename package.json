{
  "name": "revela",
  "version": "0.4.5",
  "private": true,
  "description": "Visual editor for interactive presentations with live 3D, built on reveal.js",
  "license": "MIT",
  "author": "Francisco Mesas Cervilla",
  "homepage": "https://revelaslides.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/fmesasc/revela.git"
  },
  "bugs": {
    "url": "https://github.com/fmesasc/revela/issues"
  },
  "keywords": [
    "presentation",
    "slides",
    "reveal.js",
    "3d",
    "model-viewer",
    "editor",
    "pptx",
    "powerpoint"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "./tests/run.sh",
    "test:server": "node tests/server.mjs && node tests/server-api.mjs && node tests/server-lti.mjs && node tests/server-blender.mjs",
    "build": "node tools/build-site.mjs",
    "build:open": "node tools/build-site.mjs _site --open",
    "build:desktop": "node tools/build-site.mjs desktop/dist --app-only"
  }
}
